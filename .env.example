# Obrigatórias para o LYNK Hub
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Obrigatória para integrações server-side como Google Calendar.
# Nunca exponha esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth / Calendar
# Use o mesmo Client ID e Client Secret configurados no provider Google do Supabase.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Integrações antigas (Stripe, Google Places, IA, WhatsApp, Resend/SMTP,
# Netlify etc.) não são necessárias para a experiência interna do LYNK Hub.
